<?xml version="1.0" ?>
<!--
  coordination_empty.world
  Minimal world for swarm-coordination baseline experiments:
  - No internal obstacles
  - No boundary walls
  - Goal marker only
-->
<sdf version="1.7">
  <world name="coordination_empty">
    <gravity>0 0 -9.8</gravity>
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
        </solver>
      </ode>
    </physics>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.72 0.72 0.72 1</background>
      <shadows>true</shadows>
    </scene>

    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Goal zone marker at (17, 10) -->
    <model name="goal_marker">
      <static>true</static>
      <pose>17 10 0.01 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry>
            <cylinder>
              <radius>1.2</radius>
              <length>0.02</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0 0.9 0 0.6</ambient>
            <diffuse>0 0.9 0 0.6</diffuse>
            <emissive>0 0.4 0 0</emissive>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
